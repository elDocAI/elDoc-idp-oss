    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reset-bytedeco-runtime-staging</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <condition property="bytedeco.unsupported.platform">
                                    <or>
                                        <equals arg1="${javacpp.platform}" arg2="unsupported"/>
                                        <equals arg1="${native.libs.platform}" arg2="unsupported"/>
                                    </or>
                                </condition>
                                <fail if="bytedeco.unsupported.platform"
                                      message="No Bytedeco native classifier is configured for this OS and CPU architecture."/>
                                <delete dir="${project.build.directory}/bytedeco-runtime-libs"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-bytedeco-runtime-libraries</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <resourcecount property="bytedeco.host.jar.count">
                                    <fileset dir="${project.build.directory}/bytedeco-runtime-libs"
                                             includes="*-${javacpp.platform}.jar"/>
                                </resourcecount>
                                <condition property="bytedeco.host.jar.missing">
                                    <equals arg1="${bytedeco.host.jar.count}" arg2="0"/>
                                </condition>
                                <fail if="bytedeco.host.jar.missing"
                                      message="No Bytedeco JARs were resolved for ${javacpp.platform}."/>

                                <delete quiet="true">
                                    <fileset dir="${project.basedir}/../../libs"
                                             includes="javacpp-*.jar,leptonica-*.jar,openblas-*.jar,opencv-*.jar,tesseract-*.jar"
                                             erroronmissingdir="false"/>
                                    <fileset dir="${project.basedir}/../../libs/linux"
                                             includes="javacpp-*.jar,leptonica-*.jar,openblas-*.jar,opencv-*.jar,tesseract-*.jar"
                                             erroronmissingdir="false"/>
                                    <fileset dir="${project.basedir}/../../libs/win"
                                             includes="javacpp-*.jar,leptonica-*.jar,openblas-*.jar,opencv-*.jar,tesseract-*.jar"
                                             erroronmissingdir="false"/>
                                    <fileset dir="${project.basedir}/../../libs/mac"
                                             includes="javacpp-*.jar,leptonica-*.jar,openblas-*.jar,opencv-*.jar,tesseract-*.jar"
                                             erroronmissingdir="false"/>
                                </delete>
                                <mkdir dir="${project.basedir}/../../libs/${native.libs.platform}"/>
                                <copy todir="${project.basedir}/../../libs">
                                    <fileset dir="${project.build.directory}/bytedeco-runtime-libs"
                                             includes="*.jar"
                                             excludes="*-android-*.jar,*-ios-*.jar,*-linux-*.jar,*-macosx-*.jar,*-windows-*.jar"/>
                                </copy>
                                <copy todir="${project.basedir}/../../libs/${native.libs.platform}">
                                    <fileset dir="${project.build.directory}/bytedeco-runtime-libs"
                                             includes="*-${javacpp.platform}.jar"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-bytedeco-runtime-dependencies</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.bytedeco</includeGroupIds>
                            <includeScope>provided</includeScope>
                            <outputDirectory>${project.build.directory}/bytedeco-runtime-libs</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

