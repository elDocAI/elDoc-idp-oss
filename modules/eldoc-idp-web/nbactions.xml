<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>build</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>-f</goal>
            <goal>../../pom.xml</goal>
            <goal>-pl</goal>
            <goal>:eldoc-idp-web</goal>
            <goal>-am</goal>
            <goal>package</goal>
        </goals>
        <properties>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>-f</goal>
            <goal>../../pom.xml</goal>
            <goal>-pl</goal>
            <goal>:eldoc-idp-web</goal>
            <goal>-am</goal>
            <goal>package</goal>
        </goals>
        <properties>
            <netbeans.deploy>true</netbeans.deploy>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    <action>
        <actionName>rebuild</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>-f</goal>
            <goal>../../pom.xml</goal>
            <goal>-pl</goal>
            <goal>:eldoc-idp-web</goal>
            <goal>-am</goal>
            <goal>clean</goal>
            <goal>package</goal>
        </goals>
        <properties>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    <action>
        <actionName>test</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>-f</goal>
            <goal>../../pom.xml</goal>
            <goal>-pl</goal>
            <goal>:eldoc-idp-web</goal>
            <goal>-am</goal>
            <goal>test</goal>
        </goals>
        <properties>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    <action>
        <actionName>test.single</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>process-test-classes</goal>
            <goal>surefire:test</goal>
        </goals>
        <properties>
            <test>${packageClassName}</test>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>war</packaging>
            <packaging>ear</packaging>
            <packaging>ejb</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
        </goals>
        <properties>
            <netbeans.deploy.debugmode>true</netbeans.deploy.debugmode>
            <netbeans.deploy>true</netbeans.deploy>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    <action>
        <actionName>debug.test.single</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>process-test-classes</goal>
            <goal>surefire:test</goal>
        </goals>
        <properties>
            <test>${packageClassName}</test>
            <forkMode>once</forkMode>
            <maven.surefire.debug>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</maven.surefire.debug>
            <jpda.listen>true</jpda.listen>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>ejb</packaging>
            <packaging>ear</packaging>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
        </goals>
        <properties>
            <netbeans.deploy>true</netbeans.deploy>
            <netbeans.deploy.profilemode>true</netbeans.deploy.profilemode>
            <javacpp.platform.custom>true</javacpp.platform.custom>
            <javacpp.platform.host>true</javacpp.platform.host>
            <javacpp.platform.linux-x86_64>linux-x86_64</javacpp.platform.linux-x86_64>
            <javacpp.platform.windows-x86_64>windows-x86_64</javacpp.platform.windows-x86_64>
        </properties>
    </action>
    
</actions>
